{
  "name": "transmog-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run format:check",
    "lint": "eslint \"**/*.{ts,tsx,mts,cts}\" --max-warnings 0",
    "lint:fix": "npm run format && npm run lint -- --fix && npm run format",
    "format": "prettier --write \"**/*.{ts,tsx,mts,cts,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,cts,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@msgpack/msgpack": "3.1.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "bson": "7.3.3",
    "cborg": "6.1.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "protobufjs": "8.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "engines": {
    "node": ">=24"
  }
}
