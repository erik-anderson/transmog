{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transmog",
  "version": "0.0.1",
  "identifier": "app.transmog.desktop",
  "build": {
    "frontendDist": "transmog-ui://localhost/"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Erik Anderson",
    "homepage": "https://github.com/erik-anderson/transmog",
    "copyright": "Copyright © 2026 Erik Anderson",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Native break-and-inspect HTTP proxy",
    "longDescription": "Transmog is a Windows desktop developer tool for inspecting, breaking, modifying, replaying, and exporting HTTP traffic.",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "startMenuFolder": "Transmog",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": [
          "English"
        ],
        "template": "windows/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDQTQwQkEyRjE2NkI2MTUKUldRVnRtYnhvZ3VrekswekxoaWVGalgrbEZaUmlWQTNiWmpCd1NSMmhmbjJOQ0RCVWFNUUxBYXgK",
      "endpoints": [
        "https://github.com/erik-anderson/transmog/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
