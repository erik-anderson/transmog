{
  "name": "@transmog/desktop-ui",
  "version": "0.1.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build-client.mjs",
    "check": "tsc --noEmit && node --test scripts/test-inspection-copy.mjs scripts/test-traffic-ranges.mjs scripts/test-automation-state.mjs scripts/test-build-credits.mjs scripts/test-response-body-codec.mjs scripts/test-timings.mjs scripts/test-timeline-model.mjs scripts/test-markers.mjs scripts/test-desktop-memory.mjs && node build-client.mjs",
    "test:workspaces": "node scripts/check-workspaces.mjs",
    "smoke:webview": "node scripts/smoke-webview.mjs",
    "soak:webview": "node scripts/smoke-webview.mjs --soak-minutes 30"
  },
  "dependencies": {
    "@microsoft/webui-framework": "0.0.30",
    "@tauri-apps/api": "2.12.4",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "@types/trusted-types": "2.0.7",
    "@microsoft/webui": "0.0.30",
    "@tauri-apps/cli": "2.12.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "allowScripts": {
    "@microsoft/webui@0.0.30": true,
    "esbuild@0.28.2": true
  }
}
