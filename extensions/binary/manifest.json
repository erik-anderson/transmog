      "id": "protobuf-request",
      "name": "Protobuf",
      "entry": "dist/runtime/protobuf.js",
      "surfaces": ["body"],
      "automatic": true,
      "inputs": {
        "request": {
          "headers": ["content-type", "content-encoding"],
          "body": "required",
          "decodeHttpContent": true
        },
        "response": {
          "headers": [],
          "body": "none"
        }
      },
      "matches": [
        {
          "direction": "request",
          "contentTypes": [
            "application/protobuf",
            "application/x-protobuf",
            "application/vnd.google.protobuf"
          ]
        }
      ]
    },
