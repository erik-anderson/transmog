# Prettier checks TypeScript and JavaScript modules with LF on every platform.
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.mjs text eol=lf
fuzz/*.sh text eol=lf
fuzz/corpus/** binary
fuzz/seeds/** -text -whitespace
# Fixture hashes and archive recipes require exact bytes on every checkout.
verification/fixtures/portable/** -text
third_party/chromium-root-store/* text eol=lf
third_party/chromium-root-store/crs.pb binary
third_party/boringssl-pki/** text eol=lf -whitespace
third_party/chromium-suffix-list/** text eol=lf -whitespace
third_party/chromium-certificate-policy/** text eol=lf -whitespace
third_party/chromium-certificate-policy/*.pb binary
third_party/rust-transport/** -text -whitespace
third_party/swc-ecma-parser/** -text -whitespace
third_party/mapi-inspector/LICENSE -text -whitespace
extensions/mapi/LICENSES/** -text -whitespace
extensions/mapi/README.runtime.md -text
extensions/mapi/typescript/** text eol=lf
