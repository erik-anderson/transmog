+    "CARGO_FEATURE_USE_CUSTOM_LIBCXX",
+    "CARGO_FEATURE_V8_ENABLE_SANDBOX",
+    "CARGO_FEATURE_V8_ENABLE_POINTER_COMPRESSION",
+    "CARGO_FEATURE_V8_ENABLE_V8_CHECKS",
+    "CARGO_ENCODED_RUSTFLAGS",
+    "CARGO_CFG_TARGET_FEATURE",
+  ] {
+    identity.push_str(&env::var(key).unwrap_or_default());
+    identity.push('\n');
+  }
+  let key = sha256_hex(identity.as_bytes());
+  let out = repository
+    .join(target_root)
+    .join("native-v8")
+    .join(env::var("TARGET").unwrap())
+    .join(&key[..16]);
+
