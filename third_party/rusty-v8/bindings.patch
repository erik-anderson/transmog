+fn get_dirs() -> Dirs {
+  // Share production native artifacts across Rust profiles, with distinct
+  // outputs for the reviewed source/profile, target, features and Rust ABI.
+  let manifest = PathBuf::from(env::var_os("CARGO_MANIFEST_DIR").unwrap());
+  let repository = manifest.parent().unwrap().parent().unwrap();
+  let target_root = PathBuf::from(
+    env::var_os("CARGO_TARGET_DIR")
+      .unwrap_or_else(|| repository.join("target").into_os_string()),
+  );
+  let mut identity = concat!(
+    include_str!("profile.gn"),
+    include_str!("source.json"),
+    include_str!("native.patch")
+  )
+  .to_owned();
