+
+// Token advancement occurs before recursive grammar work can continue. Preserve
+// enough native stack for error recovery and dropping partially built nodes.
+#[cfg(all(not(any(target_arch = "wasm32", target_arch = "arm", miri)), feature = "stacker"))]
+fn parser_stack_limit_reached() -> bool {
+    stacker::remaining_stack().is_none_or(|remaining| remaining < 8 * 1024 * 1024)
+}
